# =========================================
node_modules/
dist/
out/
.next/
.vite/
.parcel-cache/
.turbo/
*.tsbuildinfo
.eslintcache

# Keep dependency lock files tracked:
# package-lock.json, yarn.lock, pnpm-lock.yaml

